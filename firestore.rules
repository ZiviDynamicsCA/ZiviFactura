rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /publicDocuments/{shareId} {
      allow read: if resource.data.active == true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.invoiceNumber is string
        && request.resource.data.invoiceNumber.size() > 0;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /paymentProofs/{ownerUid}/submissions/{submissionId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.submitterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.invoiceNumber is string
        && request.resource.data.invoiceNumber.size() > 0
        && request.resource.data.invoiceNumber.size() <= 80
        && request.resource.data.amountPaid is number
        && request.resource.data.amountPaid > 0
        && request.resource.data.amountPaid < 1000000000
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 100
        && request.resource.data.imageData.size() <= 700000
        && request.resource.data.contentType == 'image/jpeg'
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size <= 550000
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.size() <= 300
        && (
          !request.resource.data.keys().hasAny(['shareId'])
          || (
            request.resource.data.shareId is string
            && exists(/databases/$(database)/documents/publicDocuments/$(request.resource.data.shareId))
            && get(/databases/$(database)/documents/publicDocuments/$(request.resource.data.shareId)).data.active == true
            && get(/databases/$(database)/documents/publicDocuments/$(request.resource.data.shareId)).data.ownerUid == ownerUid
            && get(/databases/$(database)/documents/publicDocuments/$(request.resource.data.shareId)).data.invoiceNumber == request.resource.data.invoiceNumber
          )
        );

      allow read, update, delete: if request.auth != null && request.auth.uid == ownerUid;
    }


    match /publicForms/{formId} {
      allow read: if resource.data.active == true
        || (request.auth != null && request.auth.uid == resource.data.ownerUid);

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.companyId is int
        && request.resource.data.formKey is string
        && request.resource.data.kind is string;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /submissions/{submissionId} {
        allow create: if request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && exists(/databases/$(database)/documents/publicForms/$(formId))
          && get(/databases/$(database)/documents/publicForms/$(formId)).data.active == true
          && request.resource.data.formId == formId
          && request.resource.data.formKey == get(/databases/$(database)/documents/publicForms/$(formId)).data.formKey
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/publicForms/$(formId)).data.ownerUid
          && request.resource.data.anonymousUid == request.auth.uid
          && request.resource.data.status == 'received'
          && request.resource.data.answers is map;

        allow read, update, delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/publicForms/$(formId)).data.ownerUid;
      }
    }
  }
}
